# Telegram settings
TELEGRAM_CHANNEL=kontrollviv
TELEGRAM_POLL_INTERVAL=10

# GTFS settings
GTFS_STATIC_URL=http://track.ua-gis.com/gtfs/lviv/static.zip
GTFS_RT_URL=https://track.ua-gis.com/gtfs/lviv/vehicle_position
VEHICLE_POLL_INTERVAL=7

# Sighting lifecycle (minutes)
SIGHTING_TTL_MINUTES=20

# Gemini API key for LLM-powered parser (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# CARTO API key for map tiles (Restrict to your domain in CARTO dashboard)
CARTO_API_KEY=your_carto_api_key_here

# Admin credentials (Required to create or clear warnings)
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_SECRET_KEY=change_this_to_a_random_64_char_hex_string

# Server settings
HOST=0.0.0.0
PORT=8000
ENABLE_SWAGGER_DOCS=false
